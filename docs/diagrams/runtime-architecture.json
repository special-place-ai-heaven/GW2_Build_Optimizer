  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Nexus loads the DLL; Optimize spawns optimize_v2 against in-process GameDb",
        "Fallbacks stay off the graph: beam → synergy → legacy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and APIs",
      "items": [
        "download_all fills addon_dir/cache; optimize never calls ArenaNet",
        "LLM is Gemini, OpenAI, Anthropic, or OpenRouter; chat/radio/news share the process"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Setup needs a GW2 key, the active LLM key, and a cache build number",
        "Feedback is axum + Postgres on a separate host; the DLL only POSTs"
      ]
    }
