# Copy to .env next to compose.yml. Never commit the real file.
POSTGRES_PASSWORD=<<FILL_IN: openssl rand -hex 24>>
FEEDBACK_ADMIN_TOKEN=<<FILL_IN: openssl rand -hex 32>>
FEEDBACK_ADMIN_USER=admin
FEEDBACK_ADMIN_PASSWORD=<<FILL_IN: openssl rand -hex 24>>
FEEDBACK_SESSION_SECRET=<<FILL_IN: openssl rand -hex 32>>
FEEDBACK_IP_SALT=<<FILL_IN: openssl rand -hex 16>>
# Set when behind Traefik so rate limits use the proxy-appended client IP.
FEEDBACK_TRUST_XFF=1
MIN_ADDON_VERSION=1.6.0
