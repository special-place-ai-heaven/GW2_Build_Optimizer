{
  "_schema": "Combo field x finisher interaction table. 9 fields x 4 finishers = 36 outcomes.",
  "_why": "The rotation simulator carries 'Combo fields tracked but not simulated for damage', so every field/finisher chain scores as zero today. Published expert builds treat these as load-bearing ('a water field which you can blast and leap finisher in for extra sustain'), which means the objective cannot currently see a mechanic real builds are designed around.",
  "_rules": {
    "max_combatants_per_field": {
      "value": 5,
      "note": "Only 5 unique combatants may combo with a given field.",
      "evidence_level": "Factual",
      "sources": ["https://wiki.guildwars2.com/wiki/Combo"]
    },
    "finisher_scales_with_finisher_user": {
      "value": true,
      "note": "Combo output uses the stats of the player who applied the FINISHER, not the field. A water blast heals more from higher Healing Power, so combo value couples to gear.",
      "evidence_level": "Factual",
      "sources": ["https://guildjen.com/what-are-combo-fields-and-finishers/"]
    },
    "field_priority": {
      "value": "own_fields_first_then_oldest",
      "note": "A finisher prioritises fields you created, then the field created first.",
      "evidence_level": "Inferred",
      "sources": ["https://guildjen.com/what-are-combo-fields-and-finishers/"]
    },
    "leap_first_field_wins": {
      "value": true,
      "note": "The first field a leap passes through decides the effect. An interrupted leap produces NO finisher.",
      "evidence_level": "Factual",
      "sources": ["https://guildjen.com/what-are-combo-fields-and-finishers/"]
    },
    "projectile_partial_proc": {
      "value": 0.20,
      "note": "Some projectile finishers proc at 20% per projectile, usually slot-1 autoattacks and multi-projectile skills. Revenant Hammer autoattack is a documented 100% exception, so this is a per-skill flag and NOT a blanket rate.",
      "evidence_level": "Factual",
      "sources": ["https://wiki.guildwars2.com/wiki/Combo"]
    },
    "ordering": {
      "value": "fields_before_finishers",
      "note": "Fields must be laid before finishers land. This is a hard ordering constraint on any rotation that intends to combo.",
      "evidence_level": "Factual",
      "sources": ["https://wiki.guildwars2.com/wiki/Combo"]
    },
    "finisher_availability": {
      "note": "Not every profession has every finisher type. Leap: absent on Necromancer except Reaper or Sword via Expanded Weapon Proficiency. Projectile: absent on Guardian except Longbow via Dragonhunter/Weaponmaster Training, or Pistol via Expanded Weapon Proficiency. Whirl: absent on Engineer and Necromancer except Scrapper and Reaper, or via Weaponmaster Training on Hammer and Greatsword respectively.",
      "evidence_level": "Factual",
      "sources": ["https://wiki.guildwars2.com/wiki/Combo"]
    }
  },
  "_target_key": "self = finisher user only; area_allies = allies in the blast; enemy_hit = the struck enemy; bolts = scattered whirl projectiles, may multi-hit one target at point blank",
  "_evidence_level_key": "Factual = stated by the wiki or an in-game tooltip; Inferred = consistent secondary source, not wiki-confirmed",
  "evidence_level": "Factual",
  "sources": [
    "https://wiki.guildwars2.com/wiki/Combo",
    "https://guildjen.com/what-are-combo-fields-and-finishers/"
  ],
